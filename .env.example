# ==============================================================================
# INNOVISION INTEGRATION PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the platform:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# ── POSTGRESQL DATABASE ──────────────────────────────────────────────────────
POSTGRES_DB=innovision_platform
POSTGRES_USER=innovision
POSTGRES_PASSWORD=changeme
# Internal Docker connection URL
DATABASE_URL=postgresql+asyncpg://innovision:changeme@postgres:5432/innovision_platform

# ── REDIS MESSAGE BROKER & STREAMS ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_LOCAL_URL=redis://localhost:6379

# ── MINIO S3 OBJECT STORAGE ──────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_HOST_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false

# ── INGESTION & CAMERA REGISTRY ──────────────────────────────────────────────
CAMERA_REGISTRY_URL=http://camera_registry:8011
DOWNSAMPLE_ENABLED=true
MAX_FRAME_WIDTH=640
MAX_FRAME_HEIGHT=480

# ── UC2 FIRE / SMOKE / SPARKS CONFIGURATION ──────────────────────────────────
UC2_PORT=8030
UC2_CONF_THRESHOLD=0.20
UC2_TEMPORAL_FRAMES=3
UC2_ALERT_COOLDOWN_S=30
UC2_STREAM_GROUP=uc2_fire_smoke_cg
UC2_FRAMES_BUCKET=innovision-frames
UC2_EVIDENCE_BUCKET=innovision-evidence

# ── AUTHENTICATION & JWT SECURITY ────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OBSERVABILITY & MONITORING ───────────────────────────────────────────────
GRAFANA_PASSWORD=changeme

# ── NOTIFICATIONS & SMTP (OPTIONAL) ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@innovision.local

# ── OPERATOR DASHBOARD CLIENT-SIDE URLS (BROWSER LEVEL) ──────────────────────
VITE_AUTH_API_URL=http://localhost:8000
VITE_CAMERA_API_URL=http://localhost:8011
VITE_ALERTS_API_URL=http://localhost:8010
VITE_SOCKET_URL=http://localhost:8010
VITE_INGESTION_API_URL=http://localhost:8020
VITE_UC2_STREAM_URL=http://localhost:8030