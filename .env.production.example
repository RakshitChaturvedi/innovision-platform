# ==============================================================================
# INNOVISION / FIREGUARD AI — UC2 FIRE & SMOKE PRODUCTION CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO VERSION CONTROL
# ==============================================================================

# ── Service & Environment ─────────────────────────────────────────────────────
ENV=production
DEBUG=false
SERVICE_NAME=uc2-fire-smoke-analytics
SERVICE_PORT=8030
LOG_LEVEL=INFO

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate a secure 64-character token with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES
ALLOW_PUBLIC_REGISTRATION=false
SEED_DATABASE=false
SEED_RESET_PASSWORDS=false
CORS_ORIGINS=https://soc.innovision.internal,https://cctv.innovision.internal

# ── PostgreSQL Database Connection ────────────────────────────────────────────
# Production PostgreSQL with connection pooling
DATABASE_URL=postgresql+asyncpg://innovision_admin:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/innovision_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Redis Frame Bus & PubSub ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ── YOLO Model & Inference Engine ─────────────────────────────────────────────
# Path inside container or host filesystem
YOLO_MODEL_PATH=/app/models/best.pt
# Device mode: auto (CUDA if present, otherwise CPU), cpu, or cuda (fails clearly if no GPU)
UC2_DEVICE=auto
YOLO_IMG_SIZE=640
MODEL_VERSION=best-v2.1.0-sha227db
# SHA-256 integrity verification against production weights
EXPECTED_MODEL_CHECKSUM=227db351bf5bdeb27b86f2256d4a9b340042ea63fd0e92b0dea6734b99c482c1
VALIDATE_CHECKSUM=true

# ── Detection & Temporal State Machine Thresholds ─────────────────────────────
DETECTION_MODE=BALANCED
CONF_THRESHOLD=0.20
FIRE_CONF_THRESHOLD=0.20
SMOKE_CONF_THRESHOLD=0.18
SPARKS_CONF_THRESHOLD=0.22
TEMPORAL_FRAMES=3
ALERT_COOLDOWN_S=15.0
EVIDENCE_BUFFER_SIZE=5

# ── Camera RTSP Ingestion & Reconnect Parameters ──────────────────────────────
CAMERA_REFRESH_INTERVAL_S=30.0
CAMERA_STALE_THRESHOLD_S=15.0
CAMERA_DEGRADED_THRESHOLD_S=3.0
CAMERA_RECONNECT_INTERVAL_S=5.0
CAMERA_MAX_RECONNECT_ATTEMPTS=10
STREAM_BATCH_SIZE=10
STREAM_BLOCK_MS=500
LATEST_ONLY=true

# ── MinIO S3 Object Storage & Evidence Retention ──────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_SECURE=false
MINIO_EVIDENCE_BUCKET=innovision-evidence
MINIO_FRAMES_BUCKET=innovision-frames
JPEG_QUALITY=85
EVIDENCE_RETENTION_DAYS=30

# ── Observability & Monitoring ────────────────────────────────────────────────
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=8030
LOG_ROTATION_SIZE=100MB
LOG_RETENTION_DAYS=14
