FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN pip install --no-cache-dir \
    alembic==1.18.5 \
    sqlalchemy==2.0.51 \
    asyncpg \
    psycopg2-binary \
    redis==8.1.0 \
    minio==7.2.20 \
    pgvector==0.3.6 \
    python-dotenv==1.2.2

COPY . /app

CMD ["python", "scripts/init_platform.py"]
