# Innovision Master Dashboard Environment Variables

# Base URL / Dev Server
VITE_API_BASE_URL=http://localhost:5173

# Core Platform Services (Real Host Ports)
# If left empty, the Vite dev proxy will automatically route /api/* to localhost ports:
#   /api/auth     -> http://localhost:8000
#   /api/alerts   -> http://localhost:8010
#   /api/cameras  -> http://localhost:8011
#   /api/uc4      -> http://localhost:8024
#   /api/incidents -> http://localhost:8003
VITE_AUTH_API_URL=http://localhost:8000
VITE_CAMERA_API_URL=http://localhost:8011
VITE_ALERTS_API_URL=http://localhost:8010
VITE_INCIDENTS_API_URL=http://localhost:8003

# UC Backend Services
VITE_UC1_API_URL=http://localhost:8021
VITE_UC2_API_URL=http://localhost:8022
VITE_UC3_API_URL=http://localhost:8023
VITE_UC4_API_URL=http://localhost:8024

# Ingestion & Video Streaming
VITE_INGESTION_API_URL=http://localhost:8020

# Realtime WebSocket / Socket.IO
VITE_SOCKET_URL=http://localhost:8010